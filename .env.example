# Copy to .env and adjust. docker compose reads it automatically; the backend also reads
# backend/.env when run directly (uvicorn/celery from backend/).

# --- Docker Compose ---
POSTGRES_USER=newsclipper
POSTGRES_PASSWORD=change-me
POSTGRES_DB=newsclipper
WEB_PORT=8080

# Worker concurrency. On a shared server keep media/align low so the web UI stays responsive.
MEDIA_CONCURRENCY=2
ALIGN_CONCURRENCY=1
AI_CONCURRENCY=4
PUBLISH_CONCURRENCY=2

# --- Backend (app/core/config.py) ---
APP_ENV=prod
LOG_LEVEL=INFO
# json (one JSON object per line) or console
LOG_FORMAT=json
# POST /api/jobs/dummy and the "더미 작업 실행" button. Turn off in production.
ENABLE_DEV_ENDPOINTS=true
DUMMY_STEP_SECONDS=2

# Uploads and media processing (defaults shown)
# MAX_UPLOAD_BYTES=53687091200
# ALLOWED_EXTENSIONS=mp4,mov,mxf,mkv,ts
# Proxy is for review playback only; thumbnails and final renders use the original
# PROXY_HEIGHT=360
# PROXY_CRF=28
# x264 preset; ultrafast/superfast encode faster but make bigger proxies
# PROXY_PRESET=veryfast
# PoC: 0.3 missed anchor-shot cuts
# SCENE_THRESHOLD=0.1
# SILENCE_NOISE_DB=-35
# SILENCE_MIN_SECONDS=0.25

# Newsroom (MARS-L). "fake" serves synthetic cue sheets (backend/app/newsroom/fixtures) for any date.
NEWSROOM_PROVIDER=fake
# With NEWSROOM_PROVIDER=marsl: the access key goes in the Mars-Secret header. Keep it out of git.
# MARSL_API_KEY=
# MARSL_BASE_URL=https://api.marsl.co.kr
# MARSL_TIMEOUT_SECONDS=10
# MARSL_MAX_RETRIES=3
# Fake only: serve the fixture cue sheets for every requested date (default true)
# FAKE_NEWSROOM_ANY_DATE=true

# Metadata (spec 5.7). The LLM only adds candidates (alternative titles, summary, keywords, thumbnail
# line); without it the script-based defaults are used. off | fake | claude. Only script text is sent.
LLM_PROVIDER=fake
# With LLM_PROVIDER=claude. Keep it out of git. Without a key the LLM is skipped.
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=medium
# Station name in the description footer
# STATION_NAME=목포MBC
# Thumbnail candidates per clip
# THUMBNAIL_CANDIDATES=6

# Alignment model. fake:silent hears nothing (every clip needs a manual range): no PyTorch needed.
# ALIGN_MODEL=kresnik/wav2vec2-large-xlsr-korean

# Only needed when running the backend outside Docker:
# DATABASE_URL=postgresql+psycopg://newsclipper:change-me@localhost:5432/newsclipper
# REDIS_URL=redis://localhost:6379/0
# STORAGE_ROOT=./storage
# CORS_ORIGINS=http://localhost:5173
